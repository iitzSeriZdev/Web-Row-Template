---
// A Lucide icon, inlined at build time from lucide-static so the page makes no
// request for it. `name` is the icon's file name, e.g. "copy" or "chevron-right".
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: extra = "", size, label } = Astro.props;

// Lucide carries no brand marks; the GitHub mark is drawn filled.
const BRANDS: Record<string, string> = {
  github:
    '<path fill="currentColor" stroke="none" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"/>',
};

const cache = ((globalThis as any).__lucide ??= new Map<string, string>(Object.entries(BRANDS)));
let body = cache.get(name);
if (!body) {
  const raw = readFileSync(join(process.cwd(), "node_modules", "lucide-static", "icons", `${name}.svg`), "utf8");
  body = raw.slice(raw.indexOf(">", raw.indexOf("<svg")) + 1, raw.lastIndexOf("</svg>")).trim();
  cache.set(name, body);
}
const dim = size ? `width:${size / 16}rem;height:${size / 16}rem` : undefined;
---
<svg
  class:list={["icon", extra]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={dim}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  set:html={body}
/>
