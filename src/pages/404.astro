---
import Base from "../layouts/Base.astro";
import { docHref, homeHref } from "../lib/i18n";
---
<Base locale="en" title="Page not found" noindex alternate={homeHref("fa")}>
  <main id="content" class="container notfound">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p lang="fa" dir="rtl">صفحه‌ای که دنبال آن هستید وجود ندارد یا جابه‌جا شده است.</p>
    <div class="actions">
      <a class="btn btn-primary" href={docHref("en", "")}>Documentation</a>
      <a class="btn btn-outline" href={homeHref("fa")} lang="fa">مستندات فارسی</a>
    </div>
  </main>
</Base>
